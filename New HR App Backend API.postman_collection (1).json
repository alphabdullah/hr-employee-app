								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"full_name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"phone_number\": \"+1234567890\",\n    \"residential_address\": \"123 Main Street, City, State, 12345\",\n    \"skills\": [\"PHP\", \"Laravel\", \"MySQL\", \"JavaScript\"],\n    \"password\": \"Pass@123\"\n}"
